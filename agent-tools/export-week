#!/usr/bin/env bash
# Freeze the current week into one self-contained HTML file.
#
# No server, no network, no credentials: the snapshot is baked in, exactly like
# out/draft_terminal.html. Open it on a phone or publish it. It shows the data
# as of export time and never updates itself - re-run this to move it forward.
set -euo pipefail
cd "$(dirname "$0")/.."
# Default to the week the league is actually on. WEEK= still overrides, but a
# hardcoded 1 is how a Tuesday publish silently republishes last week.
read -r DETECTED_SEASON DETECTED_WEEK < <(./agent-tools/current-week)
SEASON="${SEASON:-$DETECTED_SEASON}"
WEEK="${WEEK:-$DETECTED_WEEK}"
# Defaults into gitignored .season/ on purpose: out/ is committed to a PUBLIC
# repo, so exporting there would publish the league roster as a side effect.
OUT="${OUT:-.season/exports/season_${SEASON}_week${WEEK}.html}"
python3 -m season refresh --season "$SEASON" --week "$WEEK" >/dev/null
python3 -m season export-static --season "$SEASON" --week "$WEEK" --file "$OUT"
